%% geossm — LRSSM pipeline AS IMPLEMENTED on branch refactor (updated through Sections M, N, I, J, 2026-11-03).
%% Boxes = steps as implemented; [JIT] = jax.jit-compiled; [host] = NumPy/SciPy/MFEM on CPU.
%% Red = open risk (finding Fxx of the audit notes): documented, not removed.
flowchart TD
    subgraph INPUT["User input"]
        GDF["GeoDataFrame (long format: site x time rows,<br/>geometry + CRS + time column)"]
        FORM["formulas: list[str] (one per response;<br/>a bare name means 'name ~ 1')"]
        DOM["domain: list[Polygon] (one per formula)"]
        CFG["JAX configuration by the user:<br/>x64 for float64 (F03), platform, allocator (F04),<br/>persistent compilation cache (J1)"]
    end

    subgraph BUILD["LRStateSpaceModel.__init__  [host]"]
        CHKD["_checkDomain (shapely validity, one per formula)"]
        DMB["DesignMatricesBuilder (per formula): validate (CRS: geographic warns, F07;<br/>non-Point sites -> centroids), time window, domain filter,<br/>repeated (site, time) rows: first kept, warned"]
        BLD["build(): balanced panel, patsy on the columns as given, then cast (F30);<br/>X (N,b,T), y (N,T); points float64"]
        STACK["stack: y_train (p,T); Xbeta (p,b,T) = block_diag_3D(X_i);<br/>missing covariates -> entries masked, X = 0 there (N-1)"]
        SUPER["StateSpaceModel.__init__  (inherited matrices = EM channel, F26)"]
    end

    subgraph MESH["Spatial discretisation (user-owned objects)  [host]"]
        MSH["buildMesh2d / buildMeshGrid2d -> meshio.Mesh<br/>(planar in CRS units, F07)"]
        SPDE["SPDEApproxCov.setup(mesh, domain) -> FEMSolver:<br/>lumped mass C, stiffness G, inner/outer nodes"]
        SETUP["model.setup(cov_fun=[...]) -> qdim, block_q, nlat;<br/>in_support: sites in the latent domains with a non-empty basis (F51);<br/>latlon vs data CRS warning"]
    end

    subgraph FIT["LRStateSpaceModel.fit(params0, options)"]
        CHK["params0 validated (N-2; FitOptions on construction)"]
        INIT["initial values [JIT]: OLS on observed entries (F53), s2e, A, f=0.8, x0, Sigma0;<br/>ks from mesh box"]
        BASIS["latent basis at the sites (SPDEApproxCov.latent_basis) [host];<br/>out-of-support sites -> missing observations"]
        KSOBJ["ks value-and-grad: module-level jit, compiled once per mesh size (F20)"]
        subgraph EM["EM loop (stopping rule F18; best iterate kept)"]
            MAT["_set_system_matrices: H = A (x) basis; R, F; Q = inv(SciPy marginal precision)<br/>returns invQ; writes cov.rescale (kept by design)"]
            ESTEP["E-step: smoother(y) on the inherited matrices<br/>(given x0/Sigma0 kept, F01)"]
            KF["filter [JIT, lax.scan], Woodbury, information-form update P = M^-1 (F34),<br/>no jitter (F15), observed rows only (F02)"]
            RTS["smoother + sufficient statistics [JIT]"]
            MSTEP["M-step (ECM, F40/F42): f = tr(Q^-1 S10)/tr(Q^-1 S00) | s2e, beta, A [JIT]<br/>| ks | Omega(new f), L-BFGS-B, relative tolerance ks_tol (F54)<br/>| x0, Sigma0 = smoothed t=0; fixed parameters kept and used by later steps"]
            CONV["convergence check on llf"]
        end
        FINAL["final E-step at the returned parameters (F08)"]
        SNAP["FittedState (frozen): configuration, estimates, fitted arrays<br/>(y_obs as fitted), in_support (F09, D)"]
        RES["LRStateSpaceResults(params, nstats, fitted_state, ...): no model reference (P1)"]
    end

    subgraph POST["Post-fit (from the fitted state only)"]
        HESS["compute_cov_params: Hessian of observed_loglik(fitted_state)<br/>[JIT, compiled once per shape, J2]; no definiteness check (Section I decision)"]
        PREDICT["predict(df) -> arrays; get_prediction(df) -> LRPredictionResults:<br/>formula builders + basis -> mean/cov, in_support;<br/>other CRS reprojected with a warning; out-of-period times dropped, warned"]
        BACK["back_transform (delta method, latent mean, F50)"]
        GEO["to_geo (in_support columns) / to_poly (in-support points)"]
    end

    GDF --> CHKD --> DMB --> BLD --> STACK --> SUPER
    FORM --> DMB
    DOM --> CHKD
    CFG -.-> SUPER
    SUPER --> SETUP
    STACK -->|points| MSH
    MSH --> SPDE --> SETUP
    SETUP --> CHK --> BASIS --> INIT --> KSOBJ --> MAT
    MAT --> ESTEP --> KF --> RTS --> MSTEP --> CONV
    CONV -->|continue| MAT
    CONV -->|stop| FINAL --> SNAP --> RES
    RES --> HESS
    RES --> PREDICT --> BACK --> GEO

    classDef risk fill:#fde2e1,stroke:#c0392b,color:#000;
    class SUPER,MSH risk;
